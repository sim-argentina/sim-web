# Template del entorno de PRUEBAS. Este archivo SÍ se versiona; solo placeholders.
#
# No hace falta completarlo a mano: "npm run pruebas:iniciar" levanta el Supabase
# local del repositorio y escribe .env.test.local con los valores reales.
#
# El guardián (lib/guardiaPruebas.ts) solo acepta un loopback validado como destino:
# 127.0.0.1, localhost o [::1], sin credenciales embebidas y sin path. Cualquier
# proyecto alojado —y en particular SIM WEB (Production) y SIM TURNOS— está
# bloqueado, incluso si se escribe acá.

SIM_TEST_SUPABASE_URL=http://127.0.0.1:55321
SIM_TEST_SUPABASE_SERVICE_ROLE_KEY=<service-role-del-stack-local>

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-del-stack-local>
SUPABASE_SERVICE_ROLE_KEY=<service-role-del-stack-local>

SIM_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

IA_PROVIDER=fake
