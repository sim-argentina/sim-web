# Variables de entorno del proyecto (solo placeholders, nunca valores reales).
# Copiar a .env.local y completar para desarrollo.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Sitio
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=

# Panel admin (login y sesión firmada)
ADMIN_PASSWORD=
STAFF_PASSWORD=
ADMIN_SESSION_SECRET=

# CRM B2B — sesión de los usuarios comerciales (/comercial). Clave de firma
# PROPIA: al menos 32 caracteres al azar y DISTINTA de ADMIN_SESSION_SECRET (si
# falta, es corta o coincide, el ingreso comercial queda cerrado: 503). Rotarla
# cierra todas las sesiones comerciales. Los usuarios y contraseñas no van acá:
# se crean desde /admin/crm/configuracion y se guardan como hash en la base.
CRM_SESSION_SECRET=

# Reseñas de Google en la Home (solo servidor; nunca NEXT_PUBLIC). Sin key, la
# Home muestra el enlace a Google Maps. Usar una key EXCLUSIVA de este servidor:
#   · Restricción de API: solo "Places API (New)".
#   · Restricción de aplicación: no "sitios web" (la consulta sale del servidor,
#     sin referer). Vercel no tiene IP de salida fija, así que tampoco por IP:
#     la protección es la restricción de API, una cuota diaria en Google Cloud
#     y los límites de /api/resenas (no hay que dejarla abierta a todas las APIs).
# GOOGLE_PLACE_ID es opcional: por defecto, el de SIM Argentina (lib/googleReviews.ts).
# Verificar (local, Preview o Producción): GET /api/admin/resenas-google/diagnostico.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Rate limit durable (opcional: sin Upstash usa memoria local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags (server-side, SIN prefijo NEXT_PUBLIC_). Habilitan solo con el
# valor exacto "true"; cualquier otra cosa deja la función apagada.
# Mensualidades SIM: en construcción. NO setear en producción hasta terminarla.
MENSUALIDADES_ENABLED=
# Reservas: experiencia post-pago (/reservas/confirmacion). KILL SWITCH: con "true",
# Mercado Pago vuelve ahí para TODAS las Reservas web; vacía o cualquier otro
# valor, el retorno de siempre (/reservas/exito|pendiente|error).
EXPERIMENTAL_RESERVA_POSTPAY=
# Marketing: formularios públicos de promociones (/promos y /promos/baja). Con
# "true" responden; además, las altas necesitan un texto PUBLICADO desde el panel
# (/admin/marketing), después de la revisión legal. Requiere la migración
# db/marketing-consentimiento.sql. No envía mensajes. Apagada, el panel tampoco
# carga altas con evidencia (captación del stand) ni publica textos; las bajas siguen.
MARKETING_CONSENTIMIENTO_ENABLED=
# Marketing: llave maestra de CAMPAÑAS. Vacía (lo normal), las API de campañas y
# el ejecutor responden 503 "Deshabilitado" y el envío real a WhatsApp no se abre
# aunque MARKETING_WHATSAPP_ENVIOS_REALES diga "true". No la cargues en Vercel.
MARKETING_CAMPANIAS_ENABLED=

# WhatsApp Cloud API — carga de Finanzas por texto (opcional; sin estas
# variables el módulo queda desactivado y la app sigue funcionando).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_APP_SECRET=

# SIM Control — recepción de jornadas de las terminales (M7).
# La flag es ESTRICTA: solo el valor exacto "true" habilita los endpoints.
# Sin el pepper, la autenticación de terminales se APAGA (503) en vez de degradarse.
SIM_CONTROL_SYNC_ENABLED=
SIM_CONTROL_CREDENTIAL_PEPPER=
